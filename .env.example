# Google Drive backup (manual, optional) — Stage 6, implemented.
# Create an OAuth 2.0 "Web application" Client ID in Google Cloud Console, add your
# deployed origin (and http://localhost:5173 for dev) under "Authorized JavaScript origins",
# then set the value below. No client secret is needed (browser-side token flow).
VITE_GOOGLE_CLIENT_ID=

# Supabase — auth, sync, collaborative inbox (Group Mode features) — Stage 7-8, not yet implemented
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
